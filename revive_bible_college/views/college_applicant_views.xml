<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_college_applicant_list" model="ir.ui.view">
        <field name="name">college.applicant.list</field>
        <field name="model">college.applicant</field>
        <field name="arch" type="xml">
            <list string="Applicants">
                <field name="applicant_code"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="term_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_college_applicant_form" model="ir.ui.view">
        <field name="name">college.applicant.form</field>
        <field name="model">college.applicant</field>
        <field name="arch" type="xml">
            <form string="Applicant">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_under_review" type="object" string="Start Review"
                            invisible="state != 'submitted'" class="oe_highlight"/>
                    <button name="action_accept" type="object" string="Accept"
                            invisible="state != 'under_review'" class="oe_highlight"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'under_review'"/>
                    <button name="action_enroll" type="object" string="Enroll as Student"
                            invisible="state != 'accepted'" class="oe_highlight"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,accepted,enrolled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Applicant Number</span>
                        <h1><field name="applicant_code" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="program_id"/>
                            <field name="term_id"/>
                            <field name="student_id" invisible="not student_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="submitted_date" readonly="1"/>
                            <field name="decision_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="decision_notes"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_college_applicants" model="ir.actions.act_window">
        <field name="name">Applicants</field>
        <field name="res_model">college.applicant</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
