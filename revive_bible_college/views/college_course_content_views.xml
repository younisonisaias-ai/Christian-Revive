<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- One lesson, opened from its module's lesson list ("Details"). Shows
         only the settings that matter for the lesson's type. -->
    <record id="view_college_course_content_form" model="ir.ui.view">
        <field name="name">college.course.content.form</field>
        <field name="model">college.course.content</field>
        <field name="arch" type="xml">
            <form string="Lesson">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. The Exodus"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="module_id" readonly="1"/>
                            <field name="course_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="content_type"/>
                            <field name="sequence"/>
                        </group>
                    </group>

                    <group string="Video" invisible="content_type != 'video'">
                        <field name="video_source" widget="radio" options="{'horizontal': true}" required="content_type == 'video'"/>
                        <field name="url" string="YouTube link" placeholder="https://www.youtube.com/watch?v=…"
                               invisible="video_source not in ('youtube', False)"/>
                    </group>
                    <div invisible="content_type != 'video' or video_source in ('youtube', False)">
                        <field name="video_size" invisible="1"/>
                        <div class="alert alert-info" role="status" invisible="video_size">
                            No video file yet. Use the button below to upload one from your computer or copy it in from Google Drive.
                        </div>
                        <group invisible="not video_size">
                            <field name="video_filename" string="Video file"/>
                            <field name="video_size_label"/>
                            <field name="drive_url" widget="url" invisible="video_source != 'drive' or not drive_url"/>
                        </group>
                        <button name="action_open_video_upload" type="object" class="btn-primary"
                                string="Upload or import video" icon="fa-cloud-upload"/>
                        <button name="action_remove_video_file" type="object" class="btn-secondary ms-2"
                                string="Remove video file" icon="fa-trash" invisible="not video_size"
                                confirm="Remove this lesson's video file from the server? Students won't be able to watch it until you add another."/>
                    </div>

                    <!-- For every video source, YouTube included. -->
                    <group string="Study extras (all optional)" class="mt-3" invisible="content_type != 'video'">
                        <group>
                            <label for="chapters_text" string="Chapters (one per line)" colspan="2"/>
                            <field name="chapters_text" nolabel="1" colspan="2"
                                   placeholder="One chapter per line, like a YouTube description:&#10;0:00 Introduction&#10;4:30 Moses and Pharaoh&#10;12:10 The Passover"/>
                            <field name="chapters_unreadable" invisible="1"/>
                            <div class="alert alert-warning" role="status" colspan="2" invisible="not chapters_unreadable">
                                These lines aren't read as chapters (use a time, then a title): <field name="chapters_unreadable" readonly="1" class="d-inline"/>
                            </div>
                        </group>
                        <group>
                            <field name="caption_file" filename="caption_filename" string="Captions (.vtt or .srt)"
                                   help="Shown over uploaded videos, and as a tap-to-jump transcript for every video."/>
                            <field name="caption_filename" invisible="1"/>
                            <field name="study_guide" filename="study_guide_filename"
                                   help="A PDF students can open from the video page."/>
                            <field name="study_guide_filename" invisible="1"/>
                        </group>
                    </group>

                    <group invisible="content_type != 'document'">
                        <field name="attachment" filename="attachment_filename" string="File"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                    <group invisible="content_type != 'link'">
                        <field name="url" string="Link"/>
                    </group>
                    <group invisible="content_type != 'text'">
                        <field name="body" nolabel="1" colspan="2" placeholder="The reading students will see…"/>
                    </group>
                    <group invisible="content_type != 'quiz'">
                        <field name="quiz_id"/>
                    </group>
                    <group invisible="content_type != 'flashcards'">
                        <field name="deck_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
