<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Questions that pause a video lesson, opened from the lesson's
         "Questions during the video" button. -->
    <record id="view_college_video_question_list" model="ir.ui.view">
        <field name="name">college.video.question.list</field>
        <field name="model">college.video.question</field>
        <field name="arch" type="xml">
            <list string="Questions during the video" default_order="pause_seconds, sequence, id"
                  decoration-warning="not has_correct_option">
                <field name="pause_time"/>
                <field name="text"/>
                <field name="has_correct_option" string="Correct answer set" widget="boolean" optional="show"/>
                <field name="answer_count" string="Answers so far" optional="show"/>
                <field name="correct_percent" string="Answered right (%)" widget="float" digits="[3,0]" optional="show"/>
                <field name="pause_seconds" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_college_video_question_form" model="ir.ui.view">
        <field name="name">college.video.question.form</field>
        <field name="model">college.video.question</field>
        <field name="arch" type="xml">
            <form string="Question during the video">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="has_correct_option">
                        No answer is marked correct yet. Tick the right one below, or students can never get it right.
                    </div>
                    <field name="has_correct_option" invisible="1"/>
                    <group>
                        <group>
                            <field name="content_id" readonly="1"/>
                            <field name="pause_time" placeholder="e.g. 4:30"/>
                        </group>
                        <group>
                            <field name="answer_count" string="Answers so far" readonly="1"/>
                            <field name="correct_percent" string="Answered right (%)" readonly="1" digits="[3,0]"/>
                        </group>
                    </group>
                    <label for="text"/>
                    <field name="text" placeholder="e.g. What did the Israelites put on their doorposts?"/>
                    <label for="option_ids" string="Answers (2 to 4, tick the correct one)"/>
                    <field name="option_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="text"/>
                            <field name="is_correct"/>
                        </list>
                    </field>
                    <label for="explanation" string="Explanation (shown after answering)"/>
                    <field name="explanation" placeholder="e.g. The blood of the lamb (Exodus 12:7, 13)."/>
                    <div class="text-muted small mt-3">
                        These are practice questions. They never change a grade or quiz score.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
