<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_college_quiz_list" model="ir.ui.view">
        <field name="name">college.quiz.list</field>
        <field name="model">college.quiz</field>
        <field name="arch" type="xml">
            <list string="Quizzes">
                <field name="name"/>
                <field name="question_count"/>
                <field name="pass_score"/>
                <field name="attempt_count"/>
            </list>
        </field>
    </record>

    <record id="view_college_quiz_form" model="ir.ui.view">
        <field name="name">college.quiz.form</field>
        <field name="model">college.quiz</field>
        <field name="arch" type="xml">
            <form string="Quiz">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_questions" type="object" class="oe_stat_button" icon="fa-question-circle">
                            <field name="question_count" widget="statinfo" string="Questions"/>
                        </button>
                        <button name="action_view_attempts" type="object" class="oe_stat_button" icon="fa-bar-chart">
                            <field name="attempt_count" widget="statinfo" string="Attempts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. The Exodus"/></h1>
                    </div>
                    <group>
                        <field name="pass_score"/>
                        <field name="shuffle_questions"/>
                        <field name="shuffle_answers"/>
                    </group>
                    <field name="description" placeholder="Shown to the student before they start..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_college_quizzes" model="ir.actions.act_window">
        <field name="name">Quizzes</field>
        <field name="res_model">college.quiz</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_college_quiz_question_list" model="ir.ui.view">
        <field name="name">college.quiz.question.list</field>
        <field name="model">college.quiz.question</field>
        <field name="arch" type="xml">
            <list string="Questions">
                <field name="sequence" widget="handle"/>
                <field name="question_type"/>
                <field name="text"/>
                <field name="has_correct_option" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_college_quiz_question_form" model="ir.ui.view">
        <field name="name">college.quiz.question.form</field>
        <field name="model">college.quiz.question</field>
        <field name="arch" type="xml">
            <form string="Question">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="has_correct_option">
                        <field name="setup_problem" readonly="1"/>
                    </div>
                    <field name="has_correct_option" invisible="1"/>
                    <group>
                        <group>
                            <field name="quiz_id" readonly="1"/>
                            <field name="question_type" widget="radio"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="image" widget="image" options="{'size': [0, 160]}"/>
                        </group>
                    </group>
                    <label for="text"/>
                    <field name="text" placeholder="e.g. Who led the Israelites out of Egypt?"/>

                    <group invisible="question_type != 'true_false'">
                        <field name="tf_answer" widget="radio" options="{'horizontal': true}"/>
                    </group>

                    <div invisible="question_type != 'fill_blank'">
                        <label for="accepted_answers" string="Accepted answers (one per line)"/>
                        <field name="accepted_answers" placeholder="heavens and the earth&#10;heaven and earth"/>
                        <div class="text-muted small">Capitals, punctuation and extra spaces are ignored. Spelling mistakes are not.</div>
                    </div>

                    <div invisible="question_type in ('true_false', 'fill_blank')">
                        <label for="option_ids" string="Options (tick every correct one)" invisible="question_type != 'multiple'"/>
                        <label for="option_ids" string="Options (tick the correct one)" invisible="question_type != 'single'"/>
                        <label for="option_ids" string="Pairs: each item and what it matches" invisible="question_type != 'matching'"/>
                        <label for="option_ids" string="Items, in the correct order (drag to reorder)" invisible="question_type != 'ordering'"/>
                        <field name="option_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="text" string="Item"/>
                                <field name="match_text" column_invisible="parent.question_type != 'matching'"/>
                                <field name="is_correct" column_invisible="parent.question_type not in ('single', 'multiple')"/>
                            </list>
                        </field>
                        <div class="text-muted small" invisible="question_type not in ('multiple', 'matching', 'ordering')">
                            Partial marks: a student gets part of this question's points for each right pick, pair or position.
                        </div>
                    </div>
                    <label for="explanation" string="Explanation (shown after answering)"/>
                    <field name="explanation" placeholder="Why that answer is right..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_college_quiz_attempt_list" model="ir.ui.view">
        <field name="name">college.quiz.attempt.list</field>
        <field name="model">college.quiz.attempt</field>
        <field name="arch" type="xml">
            <list string="Attempts" default_order="submitted_date desc">
                <field name="student_id"/>
                <field name="quiz_id"/>
                <field name="score"/>
                <field name="passed" widget="boolean_toggle" readonly="1"/>
                <field name="submitted_date"/>
            </list>
        </field>
    </record>

    <record id="view_college_quiz_attempt_form" model="ir.ui.view">
        <field name="name">college.quiz.attempt.form</field>
        <field name="model">college.quiz.attempt</field>
        <field name="arch" type="xml">
            <form string="Attempt">
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" readonly="1"/>
                            <field name="quiz_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="score" readonly="1"/>
                            <field name="passed" readonly="1"/>
                            <field name="submitted_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="answer_ids" readonly="1">
                        <list>
                            <field name="question_id"/>
                            <field name="option_id" optional="hide"/>
                            <field name="answer_text"/>
                            <field name="credit" string="Points (0-1)"/>
                            <field name="is_correct" widget="boolean_toggle"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
