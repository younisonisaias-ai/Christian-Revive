<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_college_term_list" model="ir.ui.view">
        <field name="name">college.term.list</field>
        <field name="model">college.term</field>
        <field name="arch" type="xml">
            <list string="Academic Terms">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_college_term_form" model="ir.ui.view">
        <field name="name">college.term.form</field>
        <field name="model">college.term</field>
        <field name="arch" type="xml">
            <form string="Academic Term">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Fall 2026"/></h1>
                    </div>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_college_terms" model="ir.actions.act_window">
        <field name="name">Academic Terms</field>
        <field name="res_model">college.term</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
