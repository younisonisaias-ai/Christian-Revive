<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ── Student progress ───────────────────────────────────── -->
    <record id="view_college_report_progress_list" model="ir.ui.view">
        <field name="name">college.report.progress.list</field>
        <field name="model">college.report.progress</field>
        <field name="arch" type="xml">
            <list string="Student progress" create="false" edit="false" delete="false"
                  decoration-warning="falling_behind" decoration-success="percent_done == 100">
                <header>
                    <button name="action_download_excel" type="object" string="Download Excel"
                            icon="fa-file-excel-o" display="always" class="btn-secondary"/>
                </header>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="term_id" optional="show"/>
                <field name="program_id" optional="hide"/>
                <field name="lessons_done" string="Done"/>
                <field name="lessons_total" string="of"/>
                <field name="percent_done" widget="progressbar"/>
                <field name="avg_watched" string="Videos watched (%)" digits="[3,0]"/>
                <field name="avg_quiz" string="Avg quiz (%)" digits="[3,0]"/>
                <field name="has_certificate" widget="boolean" optional="show"/>
                <field name="last_active" string="Last active"/>
                <field name="falling_behind" column_invisible="1"/>
                <field name="enrollment_state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_college_report_progress_search" model="ir.ui.view">
        <field name="name">college.report.progress.search</field>
        <field name="model">college.report.progress</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="term_id"/>
                <field name="program_id"/>
                <filter name="falling_behind" string="Falling behind" domain="[('falling_behind', '=', True)]"
                        help="Not finished, and not active in the last 14 days (or never started)."/>
                <filter name="finished" string="Finished the course" domain="[('percent_done', '>=', 100)]"/>
                <filter name="no_certificate" string="No certificate yet" domain="[('has_certificate', '=', False)]"/>
                <separator/>
                <filter name="enrolled" string="Currently enrolled" domain="[('enrollment_state', '=', 'enrolled')]"/>
                <group>
                    <filter name="by_course" string="Course" context="{'group_by': 'course_id'}"/>
                    <filter name="by_term" string="Term" context="{'group_by': 'term_id'}"/>
                    <filter name="by_program" string="Program" context="{'group_by': 'program_id'}"/>
                    <filter name="by_student" string="Student" context="{'group_by': 'student_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_college_report_progress_pivot" model="ir.ui.view">
        <field name="name">college.report.progress.pivot</field>
        <field name="model">college.report.progress</field>
        <field name="arch" type="xml">
            <pivot string="Student progress">
                <field name="course_id" type="row"/>
                <field name="percent_done" type="measure"/>
                <field name="avg_watched" type="measure"/>
                <field name="avg_quiz" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_college_report_progress" model="ir.actions.act_window">
        <field name="name">Student progress</field>
        <field name="res_model">college.report.progress</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_enrolled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No enrolled students yet</p>
            <p>Each student's progress in each course shows here as they study in the app.</p>
        </field>
    </record>

    <!-- ── Videos ─────────────────────────────────────────────── -->
    <record id="view_college_report_video_list" model="ir.ui.view">
        <field name="name">college.report.video.list</field>
        <field name="model">college.report.video</field>
        <field name="arch" type="xml">
            <list string="Videos" create="false" edit="false" delete="false">
                <header>
                    <button name="action_download_excel" type="object" string="Download Excel"
                            icon="fa-file-excel-o" display="always" class="btn-secondary"/>
                </header>
                <field name="content_id"/>
                <field name="course_id"/>
                <field name="module_id" optional="show"/>
                <field name="video_source" optional="hide"/>
                <field name="students_enrolled" string="Enrolled"/>
                <field name="students_started" string="Started"/>
                <field name="students_finished" string="Finished"/>
                <field name="finished_percent" widget="progressbar"/>
                <field name="avg_watched" string="Avg watched (%)" digits="[3,0]"/>
            </list>
        </field>
    </record>

    <record id="view_college_report_video_form" model="ir.ui.view">
        <field name="name">college.report.video.form</field>
        <field name="model">college.report.video</field>
        <field name="arch" type="xml">
            <form string="Video" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title"><h1><field name="content_id" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="course_id"/>
                            <field name="module_id"/>
                            <field name="video_source"/>
                        </group>
                        <group>
                            <field name="students_enrolled"/>
                            <field name="students_started"/>
                            <field name="students_finished"/>
                            <field name="avg_watched" digits="[3,0]"/>
                        </group>
                    </group>
                    <separator string="Where students stop watching"/>
                    <field name="dropoff_html" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_college_report_video_search" model="ir.ui.view">
        <field name="name">college.report.video.search</field>
        <field name="model">college.report.video</field>
        <field name="arch" type="xml">
            <search>
                <field name="content_id"/>
                <field name="course_id"/>
                <filter name="watched" string="Has viewers" domain="[('students_started', '>', 0)]"/>
                <group>
                    <filter name="by_course" string="Course" context="{'group_by': 'course_id'}"/>
                    <filter name="by_source" string="Source" context="{'group_by': 'video_source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_college_report_video" model="ir.actions.act_window">
        <field name="name">Videos</field>
        <field name="res_model">college.report.video</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No video lessons yet</p>
            <p>Open a video to see where students stop watching it.</p>
        </field>
    </record>

    <!-- ── Quiz questions ─────────────────────────────────────── -->
    <record id="view_college_report_quiz_question_list" model="ir.ui.view">
        <field name="name">college.report.quiz.question.list</field>
        <field name="model">college.report.quiz.question</field>
        <field name="arch" type="xml">
            <list string="Quiz questions" create="false" edit="false" delete="false"
                  decoration-danger="percent_right &lt; 50">
                <header>
                    <button name="action_download_excel" type="object" string="Download Excel"
                            icon="fa-file-excel-o" display="always" class="btn-secondary"/>
                </header>
                <field name="question_id"/>
                <field name="quiz_id"/>
                <field name="question_type" optional="show"/>
                <field name="answers"/>
                <field name="percent_right" digits="[3,0]"/>
                <field name="avg_marks" digits="[3,0]" optional="show"/>
                <field name="common_wrong"/>
            </list>
        </field>
    </record>

    <record id="view_college_report_quiz_question_search" model="ir.ui.view">
        <field name="name">college.report.quiz.question.search</field>
        <field name="model">college.report.quiz.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="question_id"/>
                <field name="quiz_id"/>
                <filter name="hard" string="Most get it wrong" domain="[('percent_right', '&lt;', 50)]"/>
                <group>
                    <filter name="by_quiz" string="Quiz" context="{'group_by': 'quiz_id'}"/>
                    <filter name="by_type" string="Type" context="{'group_by': 'question_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_college_report_quiz_question" model="ir.actions.act_window">
        <field name="name">Quiz questions</field>
        <field name="res_model">college.report.quiz.question</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No quiz answers yet</p>
            <p>Questions show here, hardest first, once students take quizzes.</p>
        </field>
    </record>

    <!-- ── Questions during videos ────────────────────────────── -->
    <record id="view_college_report_video_question_list" model="ir.ui.view">
        <field name="name">college.report.video.question.list</field>
        <field name="model">college.report.video.question</field>
        <field name="arch" type="xml">
            <list string="Questions during videos" create="false" edit="false" delete="false"
                  decoration-danger="percent_right &lt; 50">
                <header>
                    <button name="action_download_excel" type="object" string="Download Excel"
                            icon="fa-file-excel-o" display="always" class="btn-secondary"/>
                </header>
                <field name="question_id"/>
                <field name="content_id"/>
                <field name="course_id" optional="show"/>
                <field name="pause_time"/>
                <field name="answers"/>
                <field name="percent_right" digits="[3,0]"/>
                <field name="common_wrong"/>
            </list>
        </field>
    </record>

    <record id="view_college_report_video_question_search" model="ir.ui.view">
        <field name="name">college.report.video.question.search</field>
        <field name="model">college.report.video.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="question_id"/>
                <field name="content_id"/>
                <field name="course_id"/>
                <filter name="hard" string="Most get it wrong" domain="[('percent_right', '&lt;', 50)]"/>
                <group>
                    <filter name="by_course" string="Course" context="{'group_by': 'course_id'}"/>
                    <filter name="by_video" string="Video" context="{'group_by': 'content_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_college_report_video_question" model="ir.actions.act_window">
        <field name="name">Questions during videos</field>
        <field name="res_model">college.report.video.question</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No answers yet</p>
            <p>Practice questions show here, hardest first, once students answer them in videos.</p>
        </field>
    </record>

    <!-- Right after Gradebook (3), so teachers see it without opening the "+" overflow. -->
    <menuitem id="menu_college_reports_root" name="Reports" parent="menu_bible_college_root" sequence="3"/>
    <menuitem id="menu_college_report_progress" name="Student progress" parent="menu_college_reports_root"
              action="action_college_report_progress" sequence="1"/>
    <menuitem id="menu_college_report_video" name="Videos" parent="menu_college_reports_root"
              action="action_college_report_video" sequence="2"/>
    <menuitem id="menu_college_report_quiz_question" name="Quiz questions" parent="menu_college_reports_root"
              action="action_college_report_quiz_question" sequence="3"/>
    <menuitem id="menu_college_report_video_question" name="Questions during videos" parent="menu_college_reports_root"
              action="action_college_report_video_question" sequence="4"/>

</odoo>
