<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_college_sermon_list" model="ir.ui.view">
        <field name="name">college.sermon.list</field>
        <field name="model">college.sermon</field>
        <field name="arch" type="xml">
            <list string="Sermons">
                <field name="student_id"/>
                <field name="title"/>
                <field name="scripture_passage"/>
                <field name="sermon_date"/>
                <field name="score"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'reviewed'"/>
            </list>
        </field>
    </record>

    <record id="view_college_sermon_form" model="ir.ui.view">
        <field name="name">college.sermon.form</field>
        <field name="model">college.sermon</field>
        <field name="arch" type="xml">
            <form string="Sermon">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_complete_review" type="object" string="Complete Review"
                            invisible="state != 'submitted'" class="oe_highlight"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="e.g. Grace Abounding"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="course_id"/>
                            <field name="scripture_passage"/>
                            <field name="sermon_date"/>
                        </group>
                        <group>
                            <field name="audio" filename="audio_filename"/>
                            <field name="audio_filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="manuscript" placeholder="Manuscript or outline..."/>
                    <group string="Review">
                        <group>
                            <field name="score"/>
                            <field name="reviewer_id" readonly="1"/>
                            <field name="review_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="feedback"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_college_sermons" model="ir.actions.act_window">
        <field name="name">Sermons</field>
        <field name="res_model">college.sermon</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
