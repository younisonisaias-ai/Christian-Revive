<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_college_course_list" model="ir.ui.view">
        <field name="name">college.course.list</field>
        <field name="model">college.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="name"/>
                <field name="code"/>
                <field name="program_id"/>
                <field name="credits"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_college_course_form" model="ir.ui.view">
        <field name="name">college.course.form</field>
        <field name="model">college.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Old Testament Survey"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="program_id"/>
                        </group>
                        <group>
                            <field name="credits"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Course Materials" name="content">
                            <field name="content_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="content_type"/>
                                    <field name="url"/>
                                    <field name="attachment" filename="attachment_filename"/>
                                    <field name="attachment_filename" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_college_courses" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">college.course</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
