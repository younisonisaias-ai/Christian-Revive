<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_college_course_list" model="ir.ui.view">
        <field name="name">college.course.list</field>
        <field name="model">college.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="name"/>
                <field name="code"/>
                <field name="program_id"/>
                <field name="credits"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_college_course_form" model="ir.ui.view">
        <field name="name">college.course.form</field>
        <field name="model">college.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_modules" type="object" class="oe_stat_button" icon="fa-list-ol">
                            <field name="module_count" widget="statinfo" string="Modules"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Old Testament Survey"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="program_id"/>
                        </group>
                        <group>
                            <field name="credits"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Finishing a video lesson">
                        <group>
                            <field name="video_min_watch_percent"/>
                            <field name="video_require_questions"/>
                        </group>
                        <div class="text-muted" colspan="2">
                            Applies to every video in this course. Skipped parts don't count as watched.
                            A single lesson can set its own rule instead.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_college_courses" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">college.course</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
