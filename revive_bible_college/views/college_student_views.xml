<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_college_student_list" model="ir.ui.view">
        <field name="name">college.student.list</field>
        <field name="model">college.student</field>
        <field name="arch" type="xml">
            <list string="Students">
                <field name="student_code"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="enrolled_term_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_college_student_form" model="ir.ui.view">
        <field name="name">college.student.form</field>
        <field name="model">college.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <header>
                    <button name="action_create_signin_code" type="object" string="Create Sign-in Code"
                            invisible="state == 'withdrawn'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Student Number</span>
                        <h1><field name="student_code" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="program_id"/>
                            <field name="enrolled_term_id"/>
                            <field name="applicant_id" invisible="not applicant_id"/>
                        </group>
                        <group>
                            <field name="completed_credits"/>
                            <field name="gpa"/>
                            <field name="has_password"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Course Enrollments" name="enrollments">
                            <field name="enrollment_ids">
                                <list editable="bottom">
                                    <field name="course_id"/>
                                    <field name="term_id"/>
                                    <field name="state"/>
                                    <field name="numeric_grade" readonly="grade_state != 'draft'"/>
                                    <field name="letter_grade" readonly="grade_state != 'draft'"/>
                                    <field name="grade_state" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bible Knowledge" name="bible_knowledge">
                            <field name="bible_knowledge_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="category"/>
                                    <field name="passage"/>
                                    <field name="course_id"/>
                                    <field name="score"/>
                                    <field name="verified"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ministry Competency" name="competency">
                            <field name="competency_assessment_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="competency_id"/>
                                    <field name="level"/>
                                    <field name="course_id"/>
                                    <field name="term_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sermons" name="sermons">
                            <field name="sermon_ids">
                                <list>
                                    <field name="title"/>
                                    <field name="scripture_passage"/>
                                    <field name="sermon_date"/>
                                    <field name="score"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Spiritual Formation" name="formation">
                            <field name="formation_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="activity_type"/>
                                    <field name="hours"/>
                                    <field name="mentor_id"/>
                                    <field name="verified"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fieldwork Placements" name="placements">
                            <field name="placement_ids">
                                <list>
                                    <field name="site_name"/>
                                    <field name="term_id"/>
                                    <field name="hours_completed"/>
                                    <field name="hours_required"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fees" name="fees">
                            <field name="fee_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="term_id"/>
                                    <field name="amount"/>
                                    <field name="amount_due"/>
                                    <field name="payment_state"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Graduation" name="graduation">
                            <field name="clearance_ids">
                                <list>
                                    <field name="term_id"/>
                                    <field name="state"/>
                                    <field name="cleared_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_college_students" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">college.student</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
