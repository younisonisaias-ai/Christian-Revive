<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_college_submission_list" model="ir.ui.view">
        <field name="name">college.submission.list</field>
        <field name="model">college.submission</field>
        <field name="arch" type="xml">
            <list string="Submissions">
                <field name="assignment_id"/>
                <field name="student_id"/>
                <field name="submitted_date"/>
                <field name="is_late" widget="boolean_toggle"/>
                <field name="score"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'graded'"/>
            </list>
        </field>
    </record>

    <record id="view_college_submission_form" model="ir.ui.view">
        <field name="name">college.submission.form</field>
        <field name="model">college.submission</field>
        <field name="arch" type="xml">
            <form string="Submission">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_mark_graded" type="object" string="Mark Graded"
                            invisible="state != 'submitted'" class="oe_highlight"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="assignment_id"/>
                            <field name="student_id"/>
                        </group>
                        <group>
                            <field name="submitted_date" readonly="1"/>
                            <field name="is_late" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="text_answer" placeholder="Written answer..."/>
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                    <group string="Grading">
                        <field name="score"/>
                        <field name="feedback"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
