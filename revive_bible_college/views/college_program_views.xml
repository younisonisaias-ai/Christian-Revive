<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_college_program_list" model="ir.ui.view">
        <field name="name">college.program.list</field>
        <field name="model">college.program</field>
        <field name="arch" type="xml">
            <list string="Programs">
                <field name="name"/>
                <field name="code"/>
                <field name="level"/>
                <field name="duration_terms"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_college_program_form" model="ir.ui.view">
        <field name="name">college.program.form</field>
        <field name="model">college.program</field>
        <field name="arch" type="xml">
            <form string="Program">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Diploma in Theology"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="level"/>
                        </group>
                        <group>
                            <field name="duration_terms"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Program description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_college_programs" model="ir.actions.act_window">
        <field name="name">Programs</field>
        <field name="res_model">college.program</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
