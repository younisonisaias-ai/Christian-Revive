<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Pastor voice replies are kept for 30 days, then deleted. -->
        <record id="cron_expire_voice_replies" model="ir.cron">
            <field name="name">Church: delete prayer voice replies older than 30 days</field>
            <field name="model_id" ref="volunteer_and_donation_management.model_prayer_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_voice_replies()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
    <data noupdate="1">
        <!-- Keep the next weeks of repeating services created. -->
        <record id="cron_generate_weekly_services" model="ir.cron">
            <field name="name">Church: create upcoming weekly services</field>
            <field name="model_id" ref="model_church_service_schedule"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_services()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
