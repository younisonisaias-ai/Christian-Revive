<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Glasses stock per camp -->
    <record id="view_camp_glasses_list" model="ir.ui.view">
        <field name="name">camp.glasses.list</field>
        <field name="model">camp.glasses</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="quantity &lt;= 0">
                <field name="camp_id"/>
                <field name="kind"/>
                <field name="power"/>
                <field name="quantity" sum="Pairs"/>
            </list>
        </field>
    </record>
    <record id="action_camp_glasses" model="ir.actions.act_window">
        <field name="name">Glasses stock</field>
        <field name="res_model">camp.glasses</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the ready-made glasses you take to a camp</p>
            <p>One line per power (e.g. Reading +2.00, 25 pairs). The eye station gives them out in Camp Mode.</p>
        </field>
    </record>
    <menuitem id="menu_camp_glasses" name="Glasses stock" parent="menu_camp_stations" sequence="45"
              action="action_camp_glasses" groups="group_camp_coordinator"/>

    <!-- Clinical record pages on the visit -->
    <record id="view_camp_visit_form_care" model="ir.ui.view">
        <field name="name">camp.visit.form.care</field>
        <field name="model">camp.visit</field>
        <field name="inherit_id" ref="view_camp_visit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='referrals']" position="before">
                <page string="Eye" name="eye" groups="revive_medical_camp.group_camp_nurse">
                    <field name="eye_exam_ids">
                        <list>
                            <field name="va_right"/>
                            <field name="va_left"/>
                            <field name="reading_power"/>
                            <field name="findings"/>
                            <field name="needs_specialist"/>
                            <field name="glasses_id"/>
                        </list>
                    </field>
                </page>
                <page string="Pregnancy / vaccines" name="mch" groups="revive_medical_camp.group_camp_nurse">
                    <field name="anc_check_ids">
                        <list>
                            <field name="weeks"/>
                            <field name="danger_signs"/>
                            <field name="high_risk"/>
                            <field name="tt_given"/>
                        </list>
                    </field>
                    <field name="vaccine_record_ids">
                        <list>
                            <field name="vaccine"/>
                            <field name="status"/>
                            <field name="age_months"/>
                        </list>
                    </field>
                </page>
                <page string="Photos" name="photos" groups="revive_medical_camp.group_camp_nurse">
                    <field name="photo_ids" mode="kanban">
                        <kanban>
                            <templates>
                                <t t-name="card">
                                    <field name="image" widget="image" options="{'size': [180, 180]}"/>
                                    <field name="note"/>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
