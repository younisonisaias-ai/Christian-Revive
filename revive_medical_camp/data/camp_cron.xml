<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_camp_reminders" model="ir.cron">
        <field name="name">Medical camp: prepare reminder messages</field>
        <field name="model_id" ref="model_camp_reminder"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_camp_retention" model="ir.cron">
        <field name="name">Medical camp: remove old patient details (data retention)</field>
        <field name="model_id" ref="model_camp_patient"/>
        <field name="state">code</field>
        <field name="code">model._cron_retention()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_camp_audit_cleanup" model="ir.cron">
        <field name="name">Medical camp: delete audit log older than 3 years</field>
        <field name="model_id" ref="model_camp_audit_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
