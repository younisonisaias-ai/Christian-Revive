<odoo>
    <!-- Plays on the Music list, sortable. -->
    <record id="view_music_track_list_plays" model="ir.ui.view">
        <field name="name">music.track.list.plays</field>
        <field name="model">music.track</field>
        <field name="inherit_id" ref="view_music_track_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='duration']" position="after">
                <field name="play_count"/>
            </xpath>
        </field>
    </record>

    <record id="view_music_track_form_plays" model="ir.ui.view">
        <field name="name">music.track.form.plays</field>
        <field name="model">music.track</field>
        <field name="inherit_id" ref="view_music_track_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence']" position="after">
                <field name="play_count"/>
            </xpath>
        </field>
    </record>

    <record id="view_music_track_play_graph" model="ir.ui.view">
        <field name="name">music.track.play.graph</field>
        <field name="model">music.track.play</field>
        <field name="arch" type="xml">
            <graph string="Top songs" type="bar" order="desc">
                <field name="track_id"/>
                <field name="plays" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_music_track_play_pivot" model="ir.ui.view">
        <field name="name">music.track.play.pivot</field>
        <field name="model">music.track.play</field>
        <field name="arch" type="xml">
            <pivot string="Song plays">
                <field name="track_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="plays" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_music_track_play_list" model="ir.ui.view">
        <field name="name">music.track.play.list</field>
        <field name="model">music.track.play</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" default_order="plays desc">
                <field name="date"/>
                <field name="track_id"/>
                <field name="artist"/>
                <field name="language"/>
                <field name="plays" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_music_track_play_search" model="ir.ui.view">
        <field name="name">music.track.play.search</field>
        <field name="model">music.track.play</field>
        <field name="arch" type="xml">
            <search>
                <field name="track_id"/>
                <field name="artist"/>
                <filter name="this_week" string="Last 7 days"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(days=6)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="Last 30 days"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(days=29)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_year" string="Last 12 months"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=12)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="english" string="English" domain="[('language', '=', 'english')]"/>
                <filter name="urdu" string="Urdu" domain="[('language', '=', 'urdu')]"/>
                <group>
                    <filter name="by_song" string="Song" context="{'group_by': 'track_id'}"/>
                    <filter name="by_artist" string="Artist" context="{'group_by': 'artist'}"/>
                    <filter name="by_day" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_music_top_songs" model="ir.actions.act_window">
        <field name="name">Top Songs</field>
        <field name="res_model">music.track.play</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No plays yet</p>
            <p>A play is counted when a song has played for 30 seconds in the app.</p>
        </field>
    </record>
</odoo>
